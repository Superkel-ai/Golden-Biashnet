{
  "hosting": {
    "public": "build",

    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],

    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],

    "rewrites": [
      {
        "source": "/googlec1538e340b7ed652.html",
        "destination": "/googlec1538e340b7ed652.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],

    "cleanUrls": true,

    "trailingSlash": false
  }
}